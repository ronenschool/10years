             x:Class="MauiApp2.NewPage1"
             Title="NewPage1"
             BackgroundColor="red">
    <Grid RowDefinitions="*,*" Margin="20">
        <Label TextColor="Orange" Text="ggorg" x:Name="lblResult" Grid.Row="0"/>

        <VerticalStackLayout Spacing="10" Grid.Row="1" VerticalOptions="End">
            <Label TextColor="Blue" Text="Your Name:"/>
